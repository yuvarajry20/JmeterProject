          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 Assertion" enabled="false">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper

def json = new JsonSlurper().parseText(prev.getResponseDataAsString())

// Check Project and Activity ID
assert json.data[0].project.id.toString() == vars.get(&quot;projectId&quot;) : &quot;Project ID mismatch&quot;
assert json.data[0].activity.id.toString() == vars.get(&quot;activityId&quot;) : &quot;Activity ID mismatch&quot;

// Check durations for each weekday
(1..5).each { i -&gt;
    def dateKey = vars.get(&quot;weekday_&quot; + i)  // e.g., &quot;2025-06-24&quot;
    def expectedDuration = vars.get(&quot;duration_&quot; + i) // e.g., &quot;08:00&quot;
    def actualDuration = json.data[0].dates[dateKey]?.duration

    assert actualDuration == expectedDuration : &quot;Mismatch on ${dateKey}: Expected ${expectedDuration}, Got ${actualDuration}&quot;
}
</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>
