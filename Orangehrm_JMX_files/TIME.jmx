            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="false">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.time.*
import java.time.format.DateTimeFormatter

// Get today&apos;s date
LocalDate today = LocalDate.now()

// Get Monday of current week
LocalDate monday = today.with(DayOfWeek.MONDAY)

// Formatter for output format like &quot;2025-06-24&quot;
DateTimeFormatter formatter = DateTimeFormatter.ofPattern(&quot;yyyy-MM-dd&quot;)

// Loop through Monday to Friday
(0..4).each { i -&gt;
    LocalDate day = monday.plusDays(i)
    String dayVar = &quot;weekday_&quot; + (i + 1)  // weekday_1 to weekday_5
    vars.put(dayVar, day.format(formatter))
}


</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="false">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.time.*
import java.time.format.DateTimeFormatter
import java.time.temporal.ChronoUnit

DateTimeFormatter formatter = DateTimeFormatter.ofPattern(&quot;yyyy-MM-dd&quot;)

// Step 1: Today’s date
LocalDate today = LocalDate.now()

// Step 2: First Monday of current month
LocalDate firstOfMonth = today.withDayOfMonth(1)
LocalDate firstMonday = firstOfMonth
while (firstMonday.getDayOfWeek() != DayOfWeek.MONDAY) {
    firstMonday = firstMonday.plusDays(1)
}

// Step 3: Get week index from Counter
int weekIndex = vars.get(&quot;weekIndex&quot;)?.toInteger() ?: 1
log.info(&quot;📅 weekIndex = &quot; + weekIndex)

// Step 4: If first loop, use today’s week for GET request
if (weekIndex == 1) {
    vars.put(&quot;currentDate&quot;, today.format(formatter))  // For timesheet open GET
    log.info(&quot;📌 currentDate set to TODAY =&gt; &quot; + today)
} else {
    // For PUT data (entries), calculate based on first Monday
    LocalDate weekStart = firstMonday.plusWeeks(weekIndex - 2) // Subtract 2 because week 2 = 1st week
    vars.put(&quot;currentDate&quot;, weekStart.format(formatter))
    log.info(&quot;📌 currentDate set to firstMonday + (weekIndex - 2) =&gt; &quot; + weekStart)
}

// Step 5: Generate weekday_1 to weekday_5 for that week&apos;s PUT
LocalDate baseMonday = (weekIndex == 1) ? today.with(DayOfWeek.MONDAY) : firstMonday.plusWeeks(weekIndex - 2)

(0..4).each { i -&gt;
    LocalDate day = baseMonday.plusDays(i)
    vars.put(&quot;weekday_${i + 1}&quot;, day.format(formatter))
    log.info(&quot;📆 weekday_${i + 1} = ${day.format(formatter)}&quot;)
}
</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.time.*
import java.time.format.DateTimeFormatter
import java.util.Random

// Formatter for &quot;yyyy-MM-dd&quot;
DateTimeFormatter formatter = DateTimeFormatter.ofPattern(&quot;yyyy-MM-dd&quot;)

// Get today&apos;s date and Monday of the current week
LocalDate today = LocalDate.now()
LocalDate monday = today.with(DayOfWeek.MONDAY)

// Duration generator (e.g., 01:00 to 08:00)
def rand = new Random()
def genDuration = {
    int hrs = rand.nextInt(8) + 1  // between 1 and 8
    return String.format(&quot;%02d:00&quot;, hrs)
}

// Generate variables weekday_1 to weekday_5 and duration_1 to duration_5
(0..4).each { i -&gt;
    LocalDate date = monday.plusDays(i)
//    vars.put(&quot;weekday_${i+1}&quot;, date.format(formatter))
    vars.put(&quot;duration_${i+1}&quot;, genDuration())
}</stringProp>
            </JSR223PreProcessor>
