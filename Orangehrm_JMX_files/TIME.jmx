      <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Pacing Wait TIme">
        <stringProp name="scriptLanguage">groovy</stringProp>
        <stringProp name="parameters"></stringProp>
        <stringProp name="filename"></stringProp>
        <stringProp name="cacheKey">true</stringProp>
        <stringProp name="script">// Thread-local pacing: Works correctly for each user/thread

// Get thread-specific pacing counter
int pacingCounter = vars.get(&quot;pacingCounter&quot;)?.toInteger() ?: 1
int totalIterations = 2  // Match with your loop count

// Use a unique variable per thread
String threadId = ctx.getThreadNum().toString()

long now = System.currentTimeMillis()
long pacingTime = 30000  // 30 seconds pacing
String iterationStartKey = &quot;iterationStart_&quot; + threadId

long startTime = vars.get(iterationStartKey)?.toLong() ?: now
vars.put(iterationStartKey, now.toString())  // Save for next iteration

if (pacingCounter &lt; totalIterations) {
    long elapsed = now - startTime
    long waitTime = pacingTime - elapsed

    if (waitTime &gt; 0) {
        log.info(&quot;⏳ Pacing Thread &quot; + threadId + &quot; - Waiting &quot; + waitTime + &quot; ms&quot;)
        Thread.sleep(waitTime)
    } else {
        log.info(&quot;⚡ Thread &quot; + threadId + &quot; - Already exceeded pacing&quot;)
    }
} else {
    log.info(&quot;🚀 Thread &quot; + threadId + &quot; - Last iteration, skipping wait&quot;)
}
</stringProp>
