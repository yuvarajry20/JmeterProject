          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="FirstName Generation" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// Get timestamp with milliseconds
def timestamp = new Date().format(&apos;yyyyMMddHHmmssSSS&apos;)

// Add thread number to increase uniqueness
def threadId = ctx.getThreadNum()

// Combine to form unique dynamic first name
def dynamicName = &quot;yuvaraj_${timestamp}_${threadId}&quot;

// Save to variable
vars.put(&quot;dynamicFirstName&quot;, dynamicName)
</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
        </hashTree>
